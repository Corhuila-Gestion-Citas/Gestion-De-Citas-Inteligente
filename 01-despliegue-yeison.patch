 11 files changed, 75 insertions(+), 37 deletions(-)
 create mode 100644 .env.example

diff --git a/.env.example b/.env.example
new file mode 100644
index 0000000..1eaaf45
--- /dev/null
+++ b/.env.example
@@ -0,0 +1,10 @@
+# Copia este archivo como ".env" (NO lo subas a Git) y completa los valores.
+# docker compose lee ".env" automaticamente desde la raiz del repositorio.
+
+# Secreto con el que se firman y verifican los JWT (minimo 32 caracteres).
+# Generalo con:  py -c "import secrets; print(secrets.token_urlsafe(48))"
+JWT_SECRET=
+
+# Contrasena de las bases de datos PostgreSQL.
+# Generala con el mismo comando.
+DB_PASSWORD=
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 7b2befb..5cc1c18 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -84,9 +84,18 @@ jobs:
 
       - name: Validate develop compose
         run: docker compose -f docker-compose.develop.yml config
+        env:
+          JWT_SECRET: ci-solo-para-validar-sintaxis-no-es-un-secreto
+          DB_PASSWORD: ci-solo-para-validar-sintaxis
 
       - name: Validate qa compose
         run: docker compose -f docker-compose.qa.yml config
+        env:
+          JWT_SECRET: ci-solo-para-validar-sintaxis-no-es-un-secreto
+          DB_PASSWORD: ci-solo-para-validar-sintaxis
 
       - name: Validate main compose
-        run: docker compose -f docker-compose.main.yml config
\ No newline at end of file
+        run: docker compose -f docker-compose.main.yml config
+        env:
+          JWT_SECRET: ci-solo-para-validar-sintaxis-no-es-un-secreto
+          DB_PASSWORD: ci-solo-para-validar-sintaxis
\ No newline at end of file
