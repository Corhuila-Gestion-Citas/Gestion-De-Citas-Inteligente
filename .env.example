# Copia este archivo como ".env" (NO lo subas a Git) y completa los valores.
# docker compose lee ".env" automaticamente desde la raiz del repositorio.

# Secreto con el que se firman y verifican los JWT (minimo 32 caracteres).
# Generalo con:  py -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Contrasena de las bases de datos PostgreSQL.
# Generala con el mismo comando.
DB_PASSWORD=
